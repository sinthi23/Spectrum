<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<connectionStrings>
		<add name="SpectrumConnection" connectionString="Data Source=(LocalDB)\MSSQLLocalDB;Initial Catalog=SpectrumWebForms;Integrated Security=True;MultipleActiveResultSets=True" providerName="System.Data.SqlClient" />
	</connectionStrings>
	<appSettings>
		<add key="AdminInviteCode" value="SPECTRUM-ADMIN-2026" />
	</appSettings>
	<system.web>
  <compilation debug="true" targetFramework="4.8" />
  <httpRuntime targetFramework="4.8" />
  <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="AutoID" />
  <customErrors mode="Off" />

  <authentication mode="Forms">
    <forms loginUrl="Login.aspx" timeout="60" slidingExpiration="true" />
  </authentication>

  <sessionState mode="InProc" timeout="60" cookieless="false" regenerateExpiredSessionId="true" />
</system.web>
</configuration>